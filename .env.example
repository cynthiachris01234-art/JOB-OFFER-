# ─── Supabase ────────────────────────────────────────────────────────────────
# Applications are only accepted when these are set. Resumes go to a private
# storage bucket and rows into the job_applications table; run
# supabase/schema.sql once to create both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bucket holding uploaded resumes. Only change if you named it differently.
CAREERS_RESUME_BUCKET=job-applications

# ─── Admin (/admin) ──────────────────────────────────────────────────────────
# HTTP Basic credentials for the applications view. With these unset, /admin is
# refused rather than served openly.
ADMIN_USER=
ADMIN_PASSWORD=

# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of the deployed site, used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
